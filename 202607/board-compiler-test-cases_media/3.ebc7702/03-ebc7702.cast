[3.268, "o", "\u001b[1;32minfo:\u001b[0m Creating a Ruyi virtual environment at \u001b[32mvenv-llvm-ruyisdk-ebc7702\u001b[0m...\r\n"]
[7.080, "o", "\u001b[1;32minfo:\u001b[0m The virtual enviro"]
[0.000, "o", "nment is now created.\r\n\r\nYou may activate it by sourcing the appropriate activation script i"]
[0.000, "o", "n the\r\n\u001b[32mbin\u001b[0m directory, and deactivate by in"]
[0.000, "o", "voking `ruyi-deactivate`.\r\n\r\n"]
[0.000, "o", "A fresh sysroot/pref"]
[0.000, "o", "ix is also prov"]
[0.000, "o", "isioned in the "]
[0.000, "o", "virtual environment.\r\nIt is availa"]
[0.000, "o", "ble at the follo"]
[0.000, "o", "wing path:\r\n\r"]
[0.000, "o", "\n    \u001b[32m/ho"]
[0.000, "o", "me/ubuntu/v"]
[0.000, "o", "env-llvm-ruyi"]
[0.000, "o", "sdk-ebc7702"]
[0.000, "o", "/sysroot\u001b[0m"]
[0.000, "o", "\r\n\r\nThe "]
[0.000, "o", "virtual environment also comes with ready-made CMake toolchain file\r\nand Meso"]
[0.001, "o", "n cross file. Check the virtual en"]
[0.000, "o", "viron"]
[0.000, "o", "ment roo"]
[0.006, "o", "t for those;\r\ncomments in the "]
