[4.572, "o", "\u001b[1;32minfo:\u001b[0m Creating a Ruyi virtual environment at \u001b[32mvenv-gnu-ruyisdk-ebc7702\u001b[0m...\r\n"]
[14.497, "o", "\u001b[1;32minfo:\u001b[0m The virtual environment is now cre"]
[0.001, "o", "ated.\r\n\r\nYou may activate it by sourcing the appropriate activation script in the\r\n\u001b[32mbin\u001b[0m directory, and"]
[0.000, "o", " deactivate by invoking `ruyi-deactivate`.\r\n"]
[0.000, "o", "\r\nA fresh sysroot/prefix is"]
[0.000, "o", " also provisioned i"]
[0.000, "o", "n the virtual en"]
[0.000, "o", "vironment.\r\nIt "]
[0.000, "o", "is available a"]
[0.000, "o", "t"]
[0.000, "o", " the following path:\r\n\r\n    \u001b[32m/home/ubuntu/venv-gnu-ruyisdk-ebc7702/sysroot\u001b[0m\r\n\r\nThe virtual environment also comes with ready-made CM"]
[0.000, "o", "ake toolchain file\r\nand Meson cross file. Check the virtual environment root"]
[0.006, "o", " for those;\r\ncomment"]
[0.000, "o", "s in the files contain usage instr"]
[0.000, "o", "uctions.\r\n\r\n"]
